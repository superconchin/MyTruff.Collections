generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int     @id @default(autoincrement())
  company     String  @db.VarChar(100)
  email       String  @db.VarChar(100)
  phonenumber BigInt
  role        Int
  name        String  @db.VarChar(100)
  lastname    String? @db.VarChar(100)
  password    String  @db.VarChar(100)

  @@map("users")
}
