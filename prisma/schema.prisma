generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int     @id @default(autoincrement())
  company     String?
  email       String  @unique
  phonenumber String?
  role        String?
  name        String?
  lastname    String?
  password    String? @db.VarChar(100)

  @@map("users")
}
